{
  "name": "lsa-live-timing",
  "version": "1.0.0",
  "description": "API y Portal Web de Live Timing & Telemetría en tiempo real para servidores Assetto Corsa (Emperor Servers / ACSM)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs = require('fs'); fs.copyFileSync('src/web/logo.png', 'dist/web/logo.png')\"",
    "start": "node dist/index.js"
  },
  "keywords": [
    "assetto-corsa",
    "live-timing",
    "telemetry",
    "simracing",
    "emperor-server",
    "acsm",
    "sse",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
